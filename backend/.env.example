# Port where the API will run
PORT=3333

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# Secret used to sign login tokens. Use a long random text and never share it
JWT_SECRET=change-me-to-a-long-random-text

# How long a login lasts before the user has to log in again
JWT_EXPIRES_IN=30d
